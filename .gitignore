# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# Backend env files (contain secrets — never committed; only templates are tracked)
backend/app/config/env/.env.*
!backend/app/config/env/.env.example
backend/app/config/secrets/.secrets.*
!backend/app/config/secrets/.template.secrets
# Legacy flat layout
backend/app/config/.env.*
!backend/app/config/.env.example
backend/app/config/.secrets.*
# Legacy backend root env files
backend/.env.*
backend/.secrets.*
backend/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
.uv/
*.egg-info/
dist/
build/

# The Python venv pattern "ENV/" above matches the config "env/" dir on
# case-insensitive filesystems (macOS). Re-include the dir so its committed
# template survives, while keeping the real env files ignored.
!backend/app/config/env/
backend/app/config/env/.env.*
!backend/app/config/env/.env.example
