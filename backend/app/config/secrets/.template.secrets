# Sensitive credentials. Copy to .secrets.development or .secrets.production and fill in real values.
# These files are git-ignored and must NEVER be committed.

# Supabase / PostgreSQL (Session Mode Pooler URL)
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/postgres

# AWS S3 credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
