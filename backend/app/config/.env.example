# Non-sensitive config. Copy to .env.development or .env.production and fill in values.
# Secrets do NOT go here — see .template.secrets instead.

APP_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# AWS S3
AWS_REGION=us-east-2
S3_BUCKET_NAME=conuguessr
S3_BASE_URL=https://conuguessr.s3.us-east-2.amazonaws.com
